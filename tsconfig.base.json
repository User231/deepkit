{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "useDefineForClassFields": false,
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "module": "nodenext",
    "esModuleInterop": true,
    "declaration": true,
    "composite": true,
    "skipLibCheck": true,
    "isolatedModules": true
  }
}
